# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Secretos: los DSN y los tokens nunca se versionan.
# `.env.*` es lo que atrapa a `.env.dev` y `.env.prod`: `*.env` solo cubre lo que
# **termina** en `.env`, así que sin esta línea un `.env.prod` con las credenciales
# reales se commitea sin que nada avise.
.env
*.env
.env.*
!.env.example
!.env.*.example

# Herramientas
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editores
.vscode/
.idea/

# Configuración local de Claude Code
.claude/settings.local.json

# Logs
*.log
