# Desarrollo: en local o contra las bases internas del IIEG. Copia y levanta:
#
#     cp .env.dev.example .env && docker compose up
#
# Es corto a propósito. Todo lo que no aparece aquí tiene un default que sirve; la
# tabla completa está en docs/configuracion.md, y el archivo de despliegue —con las
# ventanas de las API keys, los límites y los pools— es .env.prod.example.

# --- Perfil y entorno ---
# COMPOSE_PROFILES lo lee compose de este mismo archivo: levanta `servidor-dev`, que
# monta src/ y catalogo/ y corre con --reload. Editar un YAML del catálogo no exige
# reconstruir la imagen. No hace falta ningún --profile en la línea de comandos.
COMPOSE_PROFILES=dev
# Resuelve los dos defaults que impiden un arranque local:
#   IIEGDB_PG_SSLMODE  -> disable   (`require` truena si el PostgreSQL no tiene TLS)
#   IIEGDB_BASE_URL    -> http://localhost:8000
# El servidor lo avisa con un WARNING al arrancar: sslmode=disable es tráfico a la
# base sin cifrar. Para cualquier cosa que no sea desarrollo, .env.prod.example.
IIEGDB_ENTORNO=dev

# --- Lo único que tienes que llenar: las bases del ETL ---
# Déjalas vacías y el servidor levanta igual: las tres superficies responden y los
# indicadores dan 503. Sirve para probar el servidor desde una máquina sin ruta a las
# bases. El rol es de SOLO LECTURA — ver docs/roles-readonly.md.
IIEGDB_PG_HOST=
IIEGDB_PG_USER=
IIEGDB_PG_PASSWORD=

# `*` habilita todos los pipelines que declare el catálogo. En un despliegue se listan.
IIEGDB_PIPELINES=*

# El mismo modo que producción, para que lo que pruebes sea lo que se despliega: la
# API key se pide con POST /v1/api-keys y se devuelve una sola vez. El
# IIEGDB_REGISTRY_DSN no va aquí porque compose lo arma y gana sobre el .env.
IIEGDB_AUTH_MODE=api_key

# --- docker compose ---
# Credenciales del PostgreSQL del registro que levanta compose. Vive en su red y no se
# publica al host: no son credenciales de despliegue.
REGISTRO_USER=registro
REGISTRO_PASSWORD=registro_local
REGISTRO_DB=registro
PUERTO=8000
