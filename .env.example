# Copia este archivo a .env y llena los valores.
# NUNCA se versionan DSN ni tokens reales: aquí solo hay placeholders.

# --- Servidor por defecto ---
# De aquí salen todas las bases, salvo excepción. La base se llama igual que el
# `pipeline` del YAML, así que agregar un pipeline no agrega una línea aquí.
IIEGDB_PG_HOST=<host>
IIEGDB_PG_PORT=5432
IIEGDB_PG_USER=<usuario_readonly>
IIEGDB_PG_PASSWORD=<password>
IIEGDB_PG_SSLMODE=require

# --- Qué pipelines habilita este despliegue ---
# Lista separada por comas, o `*` para todos los que declare el catálogo.
# Un pipeline fuera de la lista y sin DSN propio no rompe el arranque: sus
# indicadores responden 503.
IIEGDB_PIPELINES=ilmm,enoe_microdatos,delitos_fuero_comun,pobreza_multidimensional

# --- Excepciones: una base en otro servidor, o con otro nombre ---
# Gana sobre el servidor por defecto. Solo para lo que se sale de la convención.
# IIEGDB_DSN_CONAPO=postgresql://<usuario>:<password>@<otro-host>:5432/<base>

# --- Autenticación ---
# api_key = API keys de autoservicio contra la base propia (producción)
# static  = tokens escritos a mano aquí abajo (desarrollo)
# jwt     = verificación contra un proveedor de identidad
IIEGDB_AUTH_MODE=api_key
IIEGDB_BASE_URL=https://<host>

# --- Registro de API keys (modo api_key) ---
# Base PROPIA de este servicio, con rol de ESCRITURA. Nunca es una de las 33 del ETL,
# y nunca se deriva de IIEGDB_PG_*, que es el rol de solo lectura.
IIEGDB_REGISTRY_DSN=postgresql://<usuario>:<password>@<host>:5432/<base_registro>

# Las tres ventanas deben cumplir CACHE_TTL_S < TOUCH_S < TTL_DAYS o el servidor no arranca.
IIEGDB_API_KEY_TTL_DAYS=90
IIEGDB_API_KEY_TOUCH_S=3600
IIEGDB_API_KEY_CACHE_TTL_S=60

# Modo static: tokens emitidos manualmente, uno por consumidor, separados por comas.
# Formato: <token>:<cliente>:<scope>[ <scope>...]  — revocar es quitar la entrada.
# En texto plano: sirve para el despliegue interno de F1, no para producción.
IIEGDB_STATIC_TOKENS=<token>:<cliente>:indicadores:read

# Modo jwt: verificación contra el JWKS del proveedor institucional.
# IIEGDB_JWKS_URI=https://<idp>/.well-known/jwks.json
# IIEGDB_ISSUER=https://<idp>/
# IIEGDB_AUDIENCE=indicadores-sieej

# --- Límites ---
IIEGDB_ROW_LIMIT=5000
IIEGDB_STATEMENT_TIMEOUT_MS=15000
IIEGDB_RATE_LIMIT=60

# Por pipeline, no globales. Ver el presupuesto de conexiones en docs/conexiones.md
# antes de subirlos: se multiplican por la cantidad de pipelines en uso.
IIEGDB_POOL_SIZE=2
IIEGDB_POOL_MAX_OVERFLOW=3
IIEGDB_POOL_TIMEOUT_S=10

# --- Operación ---
IIEGDB_LOG_LEVEL=INFO
