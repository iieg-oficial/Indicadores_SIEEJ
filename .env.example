# Copia este archivo a .env y llena los valores.
# NUNCA se versionan DSN ni tokens reales: aquí solo hay placeholders.

# --- Conexiones de solo lectura, una por pipeline catalogado ---
# Formato: IIEGDB_DSN_<PIPELINE en mayúsculas>
# Un pipeline sin DSN no rompe el arranque: sus indicadores responden 503.
IIEGDB_DSN_ILMM=postgresql://<usuario>:<password>@<host>:5432/<base>
IIEGDB_DSN_ENOE_MICRODATOS=postgresql://<usuario>:<password>@<host>:5432/<base>
IIEGDB_DSN_DELITOS_FUERO_COMUN=postgresql://<usuario>:<password>@<host>:5432/<base>
IIEGDB_DSN_POBREZA_MULTIDIMENSIONAL=postgresql://<usuario>:<password>@<host>:5432/<base>

# --- Autenticación ---
IIEGDB_AUTH_MODE=static
IIEGDB_BASE_URL=https://<host>

# Modo static: tokens emitidos manualmente, uno por consumidor.
IIEGDB_STATIC_TOKENS=<token>:<cliente>:indicadores:read

# Modo jwt: verificación contra el JWKS del proveedor institucional.
# IIEGDB_JWKS_URI=https://<idp>/.well-known/jwks.json
# IIEGDB_ISSUER=https://<idp>/
# IIEGDB_AUDIENCE=indicadores-sieej

# --- Límites ---
IIEGDB_LIMITE_FILAS=5000
IIEGDB_STATEMENT_TIMEOUT_MS=15000
IIEGDB_RATE_LIMIT=60
IIEGDB_POOL_SIZE=5
IIEGDB_POOL_MAX_OVERFLOW=10

# --- Operación ---
IIEGDB_LOG_LEVEL=INFO
